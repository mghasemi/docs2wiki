{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs-unifier.local/report.schema.json",
  "title": "Docs Unifier Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "status", "input", "result"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failed-strict-stale-fallback"]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceKind",
        "sourceValue",
        "sources",
        "title",
        "outMarkdownPath",
        "outPdfPath",
        "maxPages",
        "maxDepth",
        "skipPdf",
        "strictStaleFallback",
        "useCache",
        "cacheDir",
        "sourceCacheTtlMinutes"
      ],
      "properties": {
        "sourceKind": {
          "type": "string",
          "enum": ["github-wiki", "local", "readthedocs"]
        },
        "sourceValue": { "type": "string" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourceKind", "sourceValue"],
            "properties": {
              "sourceKind": {
                "type": "string",
                "enum": ["github-wiki", "local", "readthedocs"]
              },
              "sourceValue": { "type": "string" }
            }
          }
        },
        "title": { "type": "string" },
        "outMarkdownPath": { "type": "string" },
        "outPdfPath": { "type": "string" },
        "maxPages": { "type": "integer", "minimum": 1 },
        "maxDepth": { "type": "integer", "minimum": 0 },
        "skipPdf": { "type": "boolean" },
        "strictStaleFallback": { "type": "boolean" },
        "useCache": { "type": "boolean" },
        "cacheDir": { "type": "string" },
        "sourceCacheTtlMinutes": { "type": "integer" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "markdownPath",
        "pagesProcessed",
        "warnings",
        "warningDetails",
        "fromCache",
        "sourceFetch",
        "sourceFetches",
        "sourceCacheStats"
      ],
      "properties": {
        "markdownPath": { "type": "string" },
        "pdfPath": { "type": "string" },
        "pagesProcessed": { "type": "integer", "minimum": 0 },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "warningDetails": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message", "severity"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "severity": { "type": "string", "enum": ["warning", "error"] }
            }
          }
        },
        "fromCache": { "type": "boolean" },
        "sourceFetch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "cacheStatus"],
          "properties": {
            "adapter": {
              "type": "string",
              "enum": ["github-wiki", "local", "readthedocs"]
            },
            "cacheStatus": {
              "type": "string",
              "enum": ["hit", "miss", "stale-fallback", "disabled"]
            },
            "detail": { "type": "string" }
          }
        },
        "sourceFetches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "cacheStatus"],
            "properties": {
              "adapter": {
                "type": "string",
                "enum": ["github-wiki", "local", "readthedocs"]
              },
              "cacheStatus": {
                "type": "string",
                "enum": ["hit", "miss", "stale-fallback", "disabled"]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "sourceCacheStats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hits", "misses", "staleFallbacks", "disabled"],
          "properties": {
            "hits": { "type": "integer", "minimum": 0 },
            "misses": { "type": "integer", "minimum": 0 },
            "staleFallbacks": { "type": "integer", "minimum": 0 },
            "disabled": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
